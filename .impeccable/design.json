  "narrative": {
    "northStar": "Open Table",
    "overview": "Open Table is a warm, personal visual system built from cream, dark ink and brick. Source Sans 3 carries the interface and long-form reading; Bitter gives personal notes and quotations a distinct voice.\n\nThe material is mostly flat: open space, quiet rules and restrained surface tones organize content. Images retain the visual identity of the real projects they show. The homepage composition and audience strategy remain in PRODUCT.md and the surface brief; they are not universal layout requirements.",
    "keyCharacteristics": [
      "Warm cream canvas with dark, readable text.",
      "Brick for links, emphasis and interaction states.",
      "Open layouts divided by quiet rules.",
      "Real, uncropped project images and comfortable prose."
    ],
    "rules": [
      {
        "name": "The Reuse-a-Role Rule",
        "body": "The scale already has more steps than it needs. New interface takes the role of the nearest existing element instead of adding a size.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Interface labels, navigation, section headings and buttons use sentence case (\"Related posts\", \"Copy link\"). Headings inside published posts and project write-ups keep the case they were written in.",
        "section": "typography"
      },
      {
        "name": "The Reading Measure Rule",
        "body": "Keep long-form prose within the established 70ch measure; use the wider shell for navigation, images and supporting material.",
        "section": "typography"
      },
      {
        "name": "The Quiet Separation Rule",
        "body": "Use rules and space for ordinary content separation; reserve pronounced depth for overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use Source Sans 3 for the main interface and Bitter for the established note and quotation roles.",
      "Do keep prose near the implemented 70ch measure and let layouts stack when space narrows.",
      "Do retain visible keyboard focus and reduced-motion behavior.",
      "Do preserve project screenshots with contain sizing and pixelated rendering where the source is pixel art.",
      "Do keep each project's status beside its title, using one of the five statuses.",
      "Do write interface labels in sentence case."
    ],
    "donts": [
      "Don't add decorative glows or card stripes to the Open Table world.",
      "Don't turn open article and project rows into elevated cards.",
      "Don't apply the homepage’s three-project composition to every surface.",
      "Don't add a new font size when an existing role fits."
    ]
  }
}
