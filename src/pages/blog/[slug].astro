---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getReadingTime } from '../../utils/readingTime.js';
import { getRelatedPosts } from '../../utils/relatedPosts.js';
import { getSeriesPosts, getSeriesNavigation } from '../../utils/series.js';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog', ({ data }) => data.draft !== true);
  const sortedEntries = blogEntries.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  return sortedEntries.map((entry, index) => {
    const prevPost = index < sortedEntries.length - 1 ? sortedEntries[index + 1] : null;
    const nextPost = index > 0 ? sortedEntries[index - 1] : null;
    const relatedPosts = getRelatedPosts(entry, sortedEntries, 3);

    // Series functionality
    const seriesPosts = getSeriesPosts(entry, sortedEntries);
    const seriesNavigation = getSeriesNavigation(entry, seriesPosts);

    return {
      params: { slug: entry.id },
      props: { entry, prevPost, nextPost, relatedPosts, seriesNavigation },
    };
  });
}

const { entry, prevPost, nextPost, relatedPosts, seriesNavigation } = Astro.props;
const { Content, headings } = await render(entry);
const readingTime = getReadingTime(entry.body);
const contents = headings.filter(heading => heading.depth >= 2 && heading.depth <= 3);
---

<BaseLayout pageTitle={entry.data.title} description={entry.data.excerpt} type="article" publishDate={entry.data.pubDate}>
	<!-- Reading Progress Bar -->
	<div class="reading-progress">
		<div class="reading-progress-bar"></div>
	</div>

	<article class="blog-post">
		<Breadcrumb items={[
			{ label: 'Writing', href: '/blog' },
			{ label: entry.data.title }
		]} />
		<header class="article-heading">
			<h1>{entry.data.title}</h1>
			<div class="article-meta"><time datetime={entry.data.pubDate.toISOString()}>{entry.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time><span>{readingTime} min read</span></div>
		</header>
		{contents.length > 0 && (
			<details class="mobile-contents">
				<summary>On this page</summary>
				<nav aria-label="Article contents"><ul>{contents.map(heading => <li class:list={{ 'nested-heading': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>
			</details>
		)}
		<div class="post-layout">
			<div class="post-main">

		{seriesNavigation && (
			<div class="series-info">
				<div class="series-header">
					<h2>Part {seriesNavigation.currentPart} of {seriesNavigation.totalParts}: {seriesNavigation.seriesName}</h2>
				</div>
				<div class="series-navigation">
					{seriesNavigation.previousPost && (
						<a href={`/blog/${seriesNavigation.previousPost.id}`} class="series-nav-link prev">
							<div class="series-nav-direction">← Previous</div>
							<div class="series-nav-title">Part {seriesNavigation.previousPost.data.series.part}: {seriesNavigation.previousPost.data.title}</div>
						</a>
					)}
					{seriesNavigation.nextPost && (
						<a href={`/blog/${seriesNavigation.nextPost.id}`} class="series-nav-link next">
							<div class="series-nav-direction">Next →</div>
							<div class="series-nav-title">Part {seriesNavigation.nextPost.data.series.part}: {seriesNavigation.nextPost.data.title}</div>
						</a>
					)}
				</div>

				<details class="series-index">
					<summary>View all parts in this series</summary>
					<ol class="series-list">
						{seriesNavigation.allPosts.map((post) => (
							<li class="series-item" class:list={[{ 'current': post.id === entry.id }]}>
								{post.id === entry.id ? (
									<span class="series-current">
										<strong>Part {post.data.series.part}: {post.data.title}</strong>
										<span class="current-indicator">(You are here)</span>
									</span>
								) : (
									<a href={`/blog/${post.id}`} class="series-link">
										Part {post.data.series.part}: {post.data.title}
									</a>
								)}
							</li>
						))}
					</ol>
				</details>
			</div>
		)}

				<div class="content">
					<Content />
				</div>

				<ShareButtons title={entry.data.title} />
			</div>

			<aside class="post-sidebar">
				{headings && headings.length > 0 && (
					<TableOfContents headings={headings} />
				)}

				<div class="sidebar-section post-meta">
					<button class="copy-link-btn" title="Copy link to this post" aria-describedby="copy-status">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
							<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.72-1.71"></path>
						</svg>
						<span class="copy-text">Copy Link</span>
						<span class="copied-text" aria-hidden="true">Copied!</span>
					</button>
					<div id="copy-status" class="sr-only" role="status" aria-live="polite"></div>
				</div>

				{entry.data.tags && (
					<div class="sidebar-section tags-section">
						<h2>Tags</h2>
						<div class="tags">
							{entry.data.tags.map((tag) => (
								<a href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`} class="tag">
									{tag}
								</a>
							))}
						</div>
					</div>
				)}

				{relatedPosts && relatedPosts.length > 0 && (
					<div class="sidebar-section related-posts">
						<h2>Related Posts</h2>
						<div class="related-posts-list">
							{relatedPosts.map((relatedPost) => {
								const relatedReadingTime = getReadingTime(relatedPost.body);

								return (
									<article class="related-post-card">
										<div class="related-post-meta">
											<time>{relatedPost.data.pubDate.toLocaleDateString('en-US', {
												year: 'numeric',
												month: 'short',
												day: 'numeric'
											})}</time>
											<span class="reading-time">{relatedReadingTime} min read</span>
										</div>
										<h3 class="related-post-title">
											<a href={`/blog/${relatedPost.id}`}>{relatedPost.data.title}</a>
										</h3>
										<p class="related-post-excerpt">{relatedPost.data.excerpt}</p>
										{relatedPost.data.tags && (
											<div class="related-post-tags">
												{relatedPost.data.tags.slice(0, 3).map((tag) => (
													<span class="tag-small">{tag}</span>
												))}
											</div>
										)}
									</article>
								);
							})}
						</div>
					</div>
				)}
			</aside>
		</div>

		<nav class="post-navigation">
			<div class="nav-section">
				{prevPost && (
					<a href={`/blog/${prevPost.id}`} class="nav-link prev-post">
						<div class="nav-direction">← Previous</div>
						<div class="nav-title">{prevPost.data.title}</div>
					</a>
				)}
			</div>

			<div class="nav-center">
				<a href="/blog" class="back-to-blog">Back to writing</a>
			</div>

			<div class="nav-section">
				{nextPost && (
					<a href={`/blog/${nextPost.id}`} class="nav-link next-post">
						<div class="nav-direction">Next →</div>
						<div class="nav-title">{nextPost.data.title}</div>
					</a>
				)}
			</div>
		</nav>
	</article>
</BaseLayout>

<script>
  import { enhanceCodeBlocks } from '../../scripts/enhance-code-blocks.js';

  function initArticle() {
    if (!document.querySelector('.blog-post')) return;
    const controller = new AbortController();
    const { signal } = controller;
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
    enhanceCodeBlocks();

    // Reading progress bar functionality
    const progressBar = document.querySelector('.reading-progress-bar');
    const article = document.querySelector('article');

    if (progressBar && article) {
      function updateProgress() {
        const articleRect = article.getBoundingClientRect();
        const articleTop = articleRect.top + window.scrollY;
        const articleHeight = articleRect.height;
        const viewportHeight = window.innerHeight;
        const scrollTop = window.scrollY;

        // Calculate progress based on article position
        const articleStart = articleTop - viewportHeight * 0.2;
        const articleEnd = articleTop + articleHeight - viewportHeight * 0.8;

        const totalScrollableArea = articleEnd - articleStart;
        const currentScroll = scrollTop - articleStart;

        let progress = 0;
        if (totalScrollableArea > 0) {
          progress = Math.max(0, Math.min(100, (currentScroll / totalScrollableArea) * 100));
        }

        progressBar.style.width = `${progress}%`;

        // Show/hide progress bar based on article visibility
        if (scrollTop > articleStart && scrollTop < articleEnd + viewportHeight) {
          progressBar.parentElement.classList.add('visible');
        } else {
          progressBar.parentElement.classList.remove('visible');
        }
      }

      // Initial update
      updateProgress();

      // Update on scroll with throttling
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            updateProgress();
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true, signal });

      // Update on resize
      window.addEventListener('resize', updateProgress, { signal });
    }

    // Copy link functionality
    const copyLinkBtn = document.querySelector('.copy-link-btn');
    const copyStatus = document.getElementById('copy-status');

    function announceToScreenReader(message: string) {
      if (copyStatus) {
        copyStatus.textContent = message;
        // Clear after announcement to allow re-announcement
        setTimeout(() => {
          copyStatus.textContent = '';
        }, 1000);
      }
    }

    if (copyLinkBtn) {
      copyLinkBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);

          // Show copied state
          copyLinkBtn.classList.add('copied');
          announceToScreenReader('Link copied to clipboard');

          // Reset after 2 seconds
          setTimeout(() => {
            copyLinkBtn.classList.remove('copied');
          }, 2000);
        } catch (err) {
          // Fallback for browsers that don't support clipboard API
          const textArea = document.createElement('textarea');
          textArea.value = window.location.href;
          document.body.appendChild(textArea);
          textArea.focus();
          textArea.select();

          try {
            document.execCommand('copy');
            copyLinkBtn.classList.add('copied');
            announceToScreenReader('Link copied to clipboard');
            setTimeout(() => {
              copyLinkBtn.classList.remove('copied');
            }, 2000);
          } catch (fallbackErr) {
            console.error('Failed to copy link:', fallbackErr);
            announceToScreenReader('Failed to copy link');
          }

          document.body.removeChild(textArea);
        }
      });
    }
  }
  document.addEventListener('astro:page-load', initArticle);
</script>

<style>
.blog-post { padding-top: 40px; }
.article-heading { margin: 28px 0 44px; max-width: 1000px; }
.article-meta { display: flex; flex-wrap: wrap; gap: 10px 24px; color: var(--color-text-tertiary); font-size: 17px; }
.post-layout { display: grid; grid-template-columns: minmax(0,1fr) 220px; gap: 80px; align-items: start; }
.post-main { min-width: 0; }
.post-sidebar { min-width: 0; font-size: 1rem; }
.mobile-contents { display: none; }
.series-info { max-width: 70ch; padding: 20px 0; border-block: 1px solid var(--color-border); margin-bottom: 36px; }
.series-header h2 { font-size: 21px; margin: 0 0 18px; }
.series-navigation { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20px; }
.series-nav-link { text-decoration: none; }
.series-nav-direction { font-size: 15px; color: var(--color-text-tertiary); }
.series-nav-title { font-size: 18px; }
.series-index { margin-top: 20px; }
summary { cursor: pointer; }
.series-list { padding-left: 24px; font-size: 17px; }
.current-indicator { color: var(--color-text-tertiary); }
.copy-link-btn { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border: 1px solid var(--color-border); background: transparent; border-radius: 4px; font-size: 16px; }
.copied-text,.copied .copy-text { display: none; }
.copied .copied-text { display: inline; }
.related-post-excerpt { font-size: 16px; line-height: 1.5; }
.related-post-meta,.related-post-tags { font-size: 14px; color: var(--color-text-tertiary); }
.related-post-tags { display: flex; flex-wrap: wrap; gap: 8px; }
.post-navigation { display: grid; grid-template-columns: 1fr auto 1fr; gap: 28px; }
.nav-direction { color: var(--color-text-tertiary); font-size: 15px; }
.nav-title { font-size: 19px; }
.next-post { text-align: right; display: block; }
.reading-progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 200; opacity: 0; }
.reading-progress.visible { opacity: 1; }
.reading-progress-bar { height: 100%; width: 0; background: var(--color-primary); }
@media(max-width:1000px) { .post-layout { gap: 40px; } }
@media(max-width:800px) {
  .blog-post { padding-top: 28px; }
  .article-heading { margin-bottom: 30px; }
  .post-layout { display: block; }
  .post-sidebar { margin-top: 40px; }
  .post-sidebar :global(.toc) { display: none; }
  .mobile-contents { display: block; padding: 16px 0; border-block: 1px solid var(--color-border); margin-bottom: 30px; font-size: 17px; }
  .mobile-contents summary { font-weight: 600; }
  .mobile-contents ul { list-style: none; padding-left: 0; margin-bottom: 0; }
  .nested-heading { margin-left: 18px; }
  .post-navigation { grid-template-columns: minmax(0,1fr); }
  .next-post { text-align: left; }
  .series-navigation { grid-template-columns: minmax(0,1fr); }
}
</style>
