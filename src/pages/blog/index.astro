---
import { formatDate } from '../../utils/formatDate.js';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReadingTime } from '../../utils/readingTime.js';

const allPosts = await getCollection('blog', ({ data }) => data.draft !== true);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Get reading times for all posts
const postsWithReadingTime = sortedPosts.map((post) => {
	return {
		...post,
		readingTime: getReadingTime(post.body)
	};
});
const startingPoints = [
  { id: '2026-01-05-boring-technology-wins', subject: 'Choosing technology' },
  { id: '2025-11-10-why-rescue-projects-fail', subject: 'Rescuing systems' },
  { id: '2026-03-13-the-ic-choice', subject: 'Staying an individual contributor' },
].map(selection => {
  const post = postsWithReadingTime.find(post => post.id === selection.id);
  if (!post) throw new Error(`Selected essay is missing or unpublished: ${selection.id}`);
  return { ...post, subject: selection.subject };
});
const postsByYear = [...Map.groupBy(postsWithReadingTime, post => post.data.pubDate.getUTCFullYear())];
---

<BaseLayout pageTitle="Writing" description="Engineering principles, architecture trade-offs, and why boring technology usually wins.">
	<h1>Writing</h1>
	<p>Engineering principles, architecture trade-offs, and why boring technology usually wins.</p>
	
	<div class="blog-nav">
		<a href="#latest-writing" class="nav-link">Latest writing ↓</a>
		<a href="/series" class="nav-link">Series</a>
		<span class="separator">•</span>
		<a href="/tags" class="nav-link">Topics</a>
		<span class="separator">•</span>
		<a href="/archive" class="nav-link">Archive</a>
		<span class="separator">•</span>
		<a href="/rss.xml" class="nav-link">RSS feed</a>
	</div>
	<section class="starting-points" aria-labelledby="start-here">
		<div><h2 id="start-here">Start here</h2></div>
		<ul>
			{startingPoints.map(post => (
				<li>
					<h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
					<p class="starting-point-meta">{post.subject} · {post.readingTime} min read</p>
					<p>{post.data.excerpt}</p>
				</li>
			))}
		</ul>
	</section>
	<h2 id="latest-writing">Latest writing</h2>
	{postsByYear.map(([year, posts]) => (
		<section class="writing-year" aria-labelledby={`year-${year}`}>
			<h3 id={`year-${year}`}>{year}</h3>
			<ol class="writing-list">
				{posts.map(post => (
					<li>
						<h4><a href={`/blog/${post.id}`}>{post.data.title}</a></h4>
						<p class="writing-meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time> · {post.readingTime} min read{post.data.series && <> · Part {post.data.series.part} of “{post.data.series.name}”</>}</p>
						<p>{post.data.excerpt}</p>
					</li>
				))}
			</ol>
		</section>
	))}
</BaseLayout>

<style>
  .starting-points { max-width: none; display: grid; grid-template-columns: 1fr 2fr; gap: 64px; padding: 32px 0 0; margin: 0 0 56px; border-top: 1px solid var(--color-border); }
  .starting-points h2 { margin: 0; }
  .starting-points ul { list-style: none; margin: 0; padding: 0; }
  .starting-points li { margin: 0 0 28px; }
  .starting-points li:last-child { margin-bottom: 0; }
  .starting-points h3 { margin: 0 0 8px; font-size: 1.5rem; }
  .starting-points h3 a { color: var(--color-text-primary); text-decoration: none; }
  .starting-points h3 a:hover { color: var(--color-primary); text-decoration: underline; }
  .starting-points p { max-width: 60ch; font-size: 1.125rem; margin: 0; color: var(--color-text-secondary); }
  .starting-points .starting-point-meta { font-size: .9375rem; margin-bottom: 10px; color: var(--color-text-tertiary); }
  #latest-writing { scroll-margin-top: 32px; }
  .writing-year { max-width: none; display: grid; grid-template-columns: 1fr 2fr; gap: 64px; padding: 28px 0 0; margin: 0 0 44px; border-top: 1px solid var(--color-border); }
  .writing-year h3 { margin: 0; font-size: 1.5rem; font-variant-numeric: tabular-nums; }
  .writing-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; }
  .writing-list li { margin: 0; }
  .writing-list h4 { margin: 0 0 6px; font-size: 1.375rem; }
  .writing-list h4 a { color: var(--color-text-primary); text-decoration: none; }
  .writing-list h4 a:hover { color: var(--color-primary); text-decoration: underline; }
  .writing-list p { max-width: 60ch; font-size: 1.125rem; margin: 0; color: var(--color-text-secondary); }
  .writing-list .writing-meta { font-size: .9375rem; margin-bottom: 8px; color: var(--color-text-tertiary); }
  @media(max-width:800px) { .starting-points,.writing-year { grid-template-columns: minmax(0,1fr); gap: 24px; } }
</style>
