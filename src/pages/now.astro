---
import { formatDate } from '../utils/formatDate.js';
import BaseLayout from '../layouts/BaseLayout.astro';

const lastUpdated = new Date('2026-10-15');
---

<BaseLayout pageTitle="Now" description="What Steve Hill is doing now">
	<h1>Now</h1>
	<p class="subtitle">What I'm doing now</p>

	<div class="last-updated">
		Last updated: {formatDate(lastUpdated)}
	</div>

	<section>
		<h2>Currently working on</h2>
		<ul>
			<li><strong><a href="https://www.resourceguruapp.com" target="_blank" rel="noopener">Resource Guru</a></strong> — my day job. Rails scheduling platform, full-stack and infrastructure</li>
			<li><strong><a href="https://www.code198x.com" target="_blank" rel="noopener">Code Like It's 198x</a></strong> — programming, game-making and computing history, explored through classic computers. The site is live and operational, and the wider 198x family is also under active development</li>
			<li>Freelance client work — Rails applications and infrastructure</li>
		</ul>
	</section>

	<section>
		<h2>Learning</h2>
		<ul>
			<li>Z80, 6502, and 68000 assembly for the Code Like It's 198x curriculum</li>
			<li>Building cycle-accurate CPU emulators (Z80, 6502, 68000) alongside Code Like It's 198x</li>
		</ul>
	</section>

	<section>
		<h2>Released</h2>
		<ul>
			<li><strong><a href="/projects/rachel">Rachel</a></strong> — strategic card game for iOS, available on the <a href="https://apps.apple.com/app/id6794358319" target="_blank" rel="noopener">App Store</a></li>
		</ul>
	</section>

	<section>
		<h2>On hold</h2>
		<ul>
			<li><strong><a href="/projects/chaotic-tanx">Chaotic Tanx</a></strong> — artillery game, paused pending refactoring to address performance and playability</li>
			<li><strong><a href="/projects/romshelf">Romshelf</a></strong> — Rust/Tauri ROM collection manager, parked for now</li>
		</ul>
	</section>

	<section>
		<h2>Life</h2>
		<ul>
			<li>Living in the UK</li>
			<li>Enjoying retro gaming and preserving gaming history</li>
		</ul>
	</section>

	<section class="now-about">
		<p>This is a <a href="https://nownownow.com/about" target="_blank" rel="noopener">now page</a>,
		and if you have your own site, <a href="https://nownownow.com/about" target="_blank" rel="noopener">you should make one</a>, too.</p>
	</section>
</BaseLayout>
