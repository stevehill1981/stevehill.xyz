---
import { formatDate } from '../utils/formatDate.js';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectImage from '../components/ProjectImage.astro';
import { getReadingTime } from '../utils/readingTime.js';
import { getSelectedProjects } from '../utils/selectedProjects';
const posts = (await getCollection('blog', ({ data }) => data.draft !== true))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
const projects = await getCollection('projects', ({ data }) => data.draft !== true);
const selected = getSelectedProjects(projects);
---
<BaseLayout pageTitle="Home">
  <section class="home-introduction" aria-labelledby="hello">
    <h1 id="hello">Hello, I’m Steve.<span>I make things.</span></h1>
    <p>I’m a software engineer building apps, games and tools. My independent projects live under <a href="https://phosphene.uk">Phosphene</a>. I also run <a href="https://www.code198x.com">Code Like It’s 198x</a>, where people learn programming and game-making through classic computers.</p>
  </section>
  <section class="selected-work" aria-labelledby="selected-projects">
    <div class="section-heading"><h2 id="selected-projects">Selected projects</h2><a href="/projects">All projects →</a></div>
    <div class="selected-projects">
      {selected.map(project => (
        <article>
          <a href={`/projects/${project.id}`} class="project-image-link" aria-label={`Read about ${project.data.title}`}><ProjectImage projectId={project.id} /></a>
          <div class="project-details">
            <div class="project-heading"><h3><a href={`/projects/${project.id}`}>{project.data.title}</a></h3><span class="project-status">{project.data.status}</span></div>
            <p>{project.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="recent-writing" aria-labelledby="recent-writing">
    <div><h2 id="recent-writing">Recent writing</h2><p>Things I’ve learned along the way.</p><a href="/blog">All writing →</a></div>
    <ul>
      {posts.map(post => (
        <li>
          <a href={`/blog/${post.id}`}>{post.data.title}</a>
          <div class="writing-meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>{getReadingTime(post.body)} min read</span></div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
<style>
  .home-introduction { display: grid; grid-template-columns: 1.3fr 1fr; gap: 80px; align-items: end; max-width: none; margin: 0; padding: 55px 0 48px; }
  h1 { font-size: clamp(3rem, 5.6vw, 5rem); letter-spacing: -.035em; line-height: 1.06; margin: 0; }
  h1 span { display: block; font-family: var(--font-note); font-weight: 500; color: var(--color-primary); }
  .home-introduction p { font-size: 23px; line-height: 1.45; margin: 0; }
  .selected-work { max-width: none; margin: 0; }
  .section-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; margin-bottom: 20px; }
  .section-heading h2,.recent-writing h2 { margin: 0; font-size: 25px; }
  .section-heading > a,.recent-writing > div > a { display: inline-block; padding-block: 4px; font-size: 16px; color: var(--color-text-primary); }
  .selected-projects { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 28px; }
  .selected-projects article { min-width: 0; }
  @media(min-width:1001px) { .selected-projects :global(.project-preview img) { height: 202px; aspect-ratio: auto; } }
  .project-image-link { display: block; text-decoration: none; }
  .project-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 14px; }
  h3 { margin: 0; font-size: 23px; }
  h3 a { color: var(--color-text-primary); text-decoration: none; }
  h3 a:hover { color: var(--color-primary); text-decoration: underline; }
  .project-status { color: var(--color-text-tertiary); font-size: 15px; }
  .selected-projects p { font-size: 17px; line-height: 1.4; margin: 8px 0 0; }
  .recent-writing { max-width: none; border-top: 1px solid var(--color-border); margin: 36px 0 0; padding-top: 24px; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 28px; }
  .recent-writing ul { grid-column: span 2; }
  .recent-writing > div > p { font-size: 16px; color: var(--color-text-tertiary); margin: 8px 0 12px; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { display: flex; flex-direction: column; gap: 4px; margin: 0 0 20px; }
  li > a { font-size: 20px; color: var(--color-text-primary); text-decoration: none; }
  li > a:hover { color: var(--color-primary); text-decoration: underline; }
  .writing-meta { display: flex; flex-wrap: wrap; gap: 0 16px; color: var(--color-text-tertiary); font-size: 15px; line-height: 1.5; }
  @media(max-width:1000px) { .home-introduction { grid-template-columns: minmax(0,1fr); gap: 25px; } .project-heading { flex-wrap: wrap; gap: 4px 12px; } }
  @media(max-width:800px) { .home-introduction { grid-template-columns: minmax(0,1fr); gap: 25px; padding: 38px 0; } h1 { font-size: 52px; } .home-introduction p { font-size: 20px; } .selected-projects { grid-template-columns: minmax(0,1fr); gap: 32px; } .recent-writing { grid-template-columns: minmax(0,1fr); gap: 24px; } .recent-writing ul { grid-column: auto; } }
  @media(min-width:601px) and (max-width:1000px) {
    .selected-projects { grid-template-columns: minmax(0,1fr); gap: 28px; }
    .selected-projects article { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 24px; align-items: center; }
    .project-heading { margin-top: 0; }
    .project-details { min-width: 0; }
  }
  @media(max-width:360px) { h1 { font-size: 44px; } .section-heading { flex-wrap: wrap; gap: 10px; } }
</style>
