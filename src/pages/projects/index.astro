---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGitHubStats } from '../../utils/github';
import ProjectImage from '../../components/ProjectImage.astro';
import { getSelectedProjects, getProjectDestination } from '../../utils/selectedProjects';

const allProjects = await getCollection('projects', ({ data }) => {
  return data.draft !== true;
});
const selectedProjects = getSelectedProjects(allProjects);
const selectedIds = new Set(selectedProjects.map(project => project.id));
const sortedProjects = allProjects.filter(project => !selectedIds.has(project.id))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

// Fetch GitHub stats for all projects with GitHub URLs
const projectsWithStats = await Promise.all(
  sortedProjects.map(async (project) => {
    const stats = project.data.github ? await getGitHubStats(project.data.github) : null;
    return { ...project, githubStats: stats };
  })
);
---

<BaseLayout pageTitle="Projects" description="Steve Hill's software projects and open source contributions">
	<h1>Projects</h1>
	<p>A collection of software projects and tools I've built.</p>
	<p><a href="https://phosphene.uk" target="_blank" rel="noopener noreferrer">Phosphene</a> is the name I use for my independent software and game projects. I'm the developer behind them; App Store releases currently appear under my own name.</p>
	
	<section class="featured-projects" aria-labelledby="selected-projects">
		<h2 id="selected-projects">Selected projects</h2>
		{selectedProjects.map(project => {
			const destination = getProjectDestination(project);
			return (
				<article class="featured-project">
					<a href={`/projects/${project.id}`} aria-label={`Read about ${project.data.title}`}><ProjectImage projectId={project.id} /></a>
					<div>
						<div class="featured-project-heading"><h3><a href={`/projects/${project.id}`}>{project.data.title}</a></h3><span class="project-status">{project.data.status}</span></div>
						<p>{project.data.description}</p>
						<div class="project-actions">
							{destination && <a href={destination.href}>{destination.label} →</a>}
							{project.data.github && <a href={project.data.github}>Source on GitHub →</a>}
							<a href={`/projects/${project.id}`}>About the project →</a>
						</div>
					</div>
				</article>
			);
		})}
	</section>
	<h2>More projects and open source</h2>
	<div class="project-grid">
		{projectsWithStats.map((project) => (
			<article class="project-card">
				<div class="project-content">
					<div class="project-card-heading">
						<h3 class="project-title"><a href={`/projects/${project.id}`}>{project.data.title}</a></h3>
						{project.data.status && <span class="project-status">{project.data.status}</span>}
					</div>
					<p class="project-description">{project.data.description}</p>
					<div class="project-tech">
						{project.data.technologies.map((tech) => (
							<span class="tech-tag">{tech}</span>
						))}
					</div>
					{project.githubStats && (project.githubStats.stars > 0 || project.githubStats.forks > 0) && (
						<div class="github-stats">
							<span class="stat">
								<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
									<path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"></path>
								</svg>
								{project.githubStats.stars}
							</span>
							<span class="stat">
								<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
									<path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75v-.878a2.25 2.25 0 111.5 0v.878a2.25 2.25 0 01-2.25 2.25h-1.5v2.128a2.251 2.251 0 11-1.5 0V8.5h-1.5A2.25 2.25 0 013 6.25v-.878a2.25 2.25 0 111.5 0zM5 3.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm6.75.75a.75.75 0 100-1.5.75.75 0 000 1.5zm-3 8.75a.75.75 0 100-1.5.75.75 0 000 1.5z"></path>
								</svg>
								{project.githubStats.forks}
							</span>
						</div>
					)}
					{project.data.github && (
						<a href={project.data.github} target="_blank" rel="noopener" class="project-link">
							View on GitHub →
						</a>
					)}
				</div>
			</article>
		))}
	</div>
</BaseLayout>

<style>
  .featured-projects { max-width: none; margin: 48px 0 64px; }
  .featured-projects > h2 { margin: 0 0 28px; }
  .featured-project { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 48px; align-items: center; margin-bottom: 36px; }
  .featured-project > div { min-width: 0; }
  .featured-project > a { text-decoration: none; }
  .featured-project-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 16px; margin-bottom: 14px; }
  .featured-project h3 { margin: 0; font-size: 2rem; }
  .featured-project h3 a { color: var(--color-text-primary); text-decoration: none; }
  .featured-project h3 a:hover { color: var(--color-primary); text-decoration: underline; }
  .featured-project p { font-size: 1.125rem; color: var(--color-text-secondary); margin-bottom: 20px; }
  .project-status { font-size: 1rem; color: var(--color-text-tertiary); }
  .project-card-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 16px; margin-bottom: 14px; }
  .project-card-heading .project-title { margin: 0; }
  .project-actions { display: flex; flex-wrap: wrap; gap: 12px 24px; font-size: 1rem; }
  @media(max-width:1000px) { .featured-project { gap: 24px; } .featured-project h3 { font-size: 1.75rem; } }
  @media(max-width:600px) { .featured-project { grid-template-columns: minmax(0,1fr); gap: 20px; margin-bottom: 40px; } }
</style>
