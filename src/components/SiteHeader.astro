---
import SearchTrigger from './SearchTrigger.astro';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header style="view-transition-name: site-header;">
  <nav class="nav-container" aria-label="Main navigation">
    <a href="/" class="site-title" aria-label="Home">
      <span class="site-title-first">Steve</span>
      <span class="site-title-last">Hill</span>
    </a>
    
    <button class="mobile-menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="site-navigation">
      <svg class="menu-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M3 6h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <path d="M3 12h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <path d="M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    
    <div class="nav-links" id="site-navigation">
      <a href="/about" class:list={['nav-link', { active: currentPath === '/about' }]} aria-current={currentPath === '/about' ? 'page' : undefined}>About</a>
      <a href="/projects" class:list={['nav-link', { active: currentPath.startsWith('/projects') }]} aria-current={currentPath.startsWith('/projects') ? 'page' : undefined}>Projects</a>
      <a href="/blog" class:list={['nav-link', { active: currentPath.startsWith('/blog') }]} aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>Writing</a>
      <a href="/now" class:list={['nav-link', { active: currentPath === '/now' }]} aria-current={currentPath === '/now' ? 'page' : undefined}>Now</a>

      <div class="social-links">
        <SearchTrigger />


      </div>
    </div>
  </nav>
</header>

<script>
  function initializeMobileMenu() {
    const toggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
    const links = document.querySelector<HTMLElement>('.nav-links');
    if (!toggle || !links || toggle.dataset.initialized) return;
    toggle.dataset.initialized = 'true';
    const controller = new AbortController();
    const { signal } = controller;
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
    function closeMenu() {
      links?.classList.remove('active');
      toggle?.setAttribute('aria-expanded', 'false');
    }
    toggle.addEventListener('click', () => {
      const open = links.classList.toggle('active');
      toggle.setAttribute('aria-expanded', String(open));
    }, { signal });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Element && !event.target.closest('.nav-container')) closeMenu();
    }, { signal });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && links.classList.contains('active')) {
        closeMenu(); toggle.focus();
      }
    }, { signal });
  }
  document.addEventListener('astro:page-load', initializeMobileMenu);
</script>
<style>
  header { width: 100%; position: relative; z-index: 10; }
  .nav-container { max-width: 1408px; padding: 24px 64px; min-height: 96px; margin: auto; display: flex; justify-content: space-between; align-items: center; gap: 28px; position: relative; }
  .nav-container::after { content: ''; position: absolute; bottom: 0; left: 64px; right: 64px; border-bottom: 1px solid var(--color-border); }
  .site-title { display: flex; gap: .2em; font-size: 27px; font-weight: 700; color: var(--color-text-primary); text-decoration: none; white-space: nowrap; }
  .nav-links { display: flex; gap: 20px; align-items: center; }
  .nav-link { color: var(--color-text-primary); text-decoration: none; font-size: 17px; white-space: nowrap; }
  .nav-link:hover,.nav-link.active { color: var(--color-primary); text-decoration: underline; text-underline-offset: 6px; }
  .social-links { display: flex; align-items: center; gap: 8px; }
  .social-links a { display: inline-flex; padding: 10px; color: var(--color-text-secondary); }
  .icon { width: 19px; height: 19px; }
  .mobile-menu-toggle { display: none; background: transparent; border: 0; padding: 10px; color: var(--color-text-primary); }
  .menu-icon { width: 24px; height: 24px; }
  @media (max-width: 800px) {
    .nav-container { padding: 20px 24px; min-height: 86px; }
    .nav-container::after { left: 24px; right: 24px; }
    .mobile-menu-toggle { display: inline-flex; }
    .nav-links { display: none; }
    .nav-links.active { display: flex; position: absolute; top: 100%; left: 24px; right: 24px; z-index: 100; flex-direction: column; align-items: stretch; gap: 0; padding: 16px 20px; border: 1px solid var(--color-border); background: var(--color-bg); box-shadow: var(--shadow-md); }
    .nav-link { padding: 10px 0; }
    .social-links { margin-top: 8px; }
  }
</style>
